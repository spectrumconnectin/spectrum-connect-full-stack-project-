# Spectrum Connect - Backend environment template.
# Copy this file to `.env` (which is gitignored) and fill in real values.
# DO NOT commit real secrets to source control.

# === Core security ===
# REQUIRED in production. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# === Database (REQUIRED) ===
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net
MONGODB_DB=spectrum-connect

# === Google OAuth ===
# Get from Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google_callback

# === Facebook OAuth (optional, currently disabled in router.py) ===
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook_callback

# === Frontend URL ===
FRONTEND_URL=http://localhost:3000

# === CORS ===
# Comma-separated list of extra allowed origins in addition to FRONTEND_URL.
ALLOWED_ORIGINS=

# === Email (Brevo / SendinBlue) ===
BREVO_API_KEY=
BREVO_SMTP_USER=
FROM_EMAIL=team@example.com

# === Environment marker ===
# Set to "production" in production. Controls cookie Secure flag, OTP echo, etc.
ENVIRONMENT=development
ENV=development

# === Admin gate (REQUIRED in production) ===
# Used by /auth/register-admin and /auth/promote-to-admin. Treat as a sysadmin password.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_REGISTRATION_KEY=replace-with-long-random-admin-key

# === AWS / S3 for uploads ===
S3_MEDIA_BUCKET=your-bucket-name
AWS_DEFAULT_REGION=ap-south-1

# === Commission (v1 split 8/4) ===
# Implements "Spectrum Connect - Commission Logic (v1, Split 8/4)".
# Total platform fee = COMM_TOTAL_RATE (12% by default), split into a
# creator-side fee (8% of subtotal) and a client-side fee (4% of subtotal).
# For subtotals below COMM_MICRO_THRESHOLD, the total fee is capped at
# COMM_MICRO_CAP and split using COMM_CREATOR_PART : COMM_CLIENT_PART.
# COMM_VERSION is written into every Transaction so historical fees remain
# reproducible after any future rate change.
COMM_TOTAL_RATE=0.12
COMM_CREATOR_PART=0.6666666666666667
COMM_CLIENT_PART=0.3333333333333333
COMM_MICRO_THRESHOLD=20.00
COMM_MICRO_CAP=2.00
COMM_VERSION=v1.split.8_4
